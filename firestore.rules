rules_version = '2';

// The app's Firebase config sits in plain sight in index.html, which is how
// Firebase web apps work: the API key names the project, it does not grant
// anything. THIS FILE is the thing that actually decides who can read whose
// notes, so it belongs in version control next to the code rather than only
// in a console where nobody can review it.
//
// This matches what is deployed, so `firebase deploy --only firestore:rules`
// should be a no-op. Keep it that way.
service cloud.firestore {
  match /databases/{database}/documents {

    // index.html touches exactly one path:
    //   firebase.firestore().collection('users').doc(currentUser.uid)
    //
    // Signed in, and only your own document. `request.auth != null` on its
    // own would not be enough — that lets any Google account read any other
    // reader's notes, which is the failure worth being careful about.
    //
    // Nothing else needs saying: Firestore denies by default, so every path
    // without an `allow` that evaluates true is already closed. A catch-all
    // `allow read, write: if false` would add nothing, because matching
    // rules are OR'd together — a deny cannot take back another rule's
    // grant, and there is nothing else here to deny.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
