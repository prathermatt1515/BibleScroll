rules_version = '2';

// The app's Firebase config sits in plain sight in index.html, which is how
// Firebase web apps work: the API key names the project, it does not grant
// anything. THIS FILE is the thing that actually decides who can read whose
// notes, so it belongs in version control next to the code rather than only
// in a console where nobody can review it.
//
// Keep this in step with what is deployed in the Firebase console
// (Firestore Database > Rules). After changing it here, paste it there and
// Publish, or run `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each reader's own notes, saves, reading progress and devotion
    // check-offs: firebase.firestore().collection('users').doc(currentUser.uid)
    //
    // Signed in, and only your own document. `request.auth != null` on its
    // own would not be enough — that lets any Google account read any other
    // reader's notes, which is the failure worth being careful about.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A family's shared catechism wording, typed or pasted in by the family
    // for their own memory work. It never lives in the public code; only the
    // people on the list can read it.
    //   firebase.firestore().collection('families').doc(ownerUid)
    //
    // The owner (the account whose uid names the document) creates it,
    // manages who is in `members` (Google sign-in emails), and can delete it.
    // Members can read it and edit the wording, but may change nothing else,
    // so a member cannot add people or take the family over.
    //
    // Members find their family with
    //   where('members', 'array-contains', <their email>)
    // which these rules can verify, because the read condition is the same
    // membership test the query filters on.
    match /families/{ownerId} {
      function signedIn() { return request.auth != null; }
      function isOwner() { return signedIn() && request.auth.uid == ownerId; }
      function isMember(data) {
        return signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email in data.members;
      }

      allow read: if isOwner() || isMember(resource.data);

      allow create: if isOwner()
        && request.resource.data.owner == ownerId
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 20;

      allow update: if (isOwner()
          && request.resource.data.owner == ownerId
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 20)
        || (isMember(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['catechism', 'updatedAt']));

      allow delete: if isOwner();
    }
  }
}
